# =================================================================
# KumbhStay — Environment Configuration Template
# NOTE: Never commit real credentials or secrets to version control.
# Copy this file to server/.env and fill in your actual values.
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Native MongoDB or MongoMemoryServer fallback in development)
MONGODB_URI=mongodb://localhost:27017/kumbhstay

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Razorpay Test Mode Credentials (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Admin Console Credentials (Protected at /admin/verification-console)
ADMIN_EMAIL=admin@kumbhstaynashik.local
ADMIN_PASSWORD=your_secure_admin_password

# Optional Integrations
GOOGLE_PLACES_API_KEY=
